<resources
    xmlns="https://api-platform.com/schema/metadata/resources-3.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://api-platform.com/schema/metadata/resources-3.0 https://api-platform.com/schema/metadata/resources-3.0.xsd"
>
    <resource class="%sylius.model.newsletter_subscription_log_entry.class%">
        <operations>
            <operation name="sylius_api_admin_newsletter_subscription_log_entry_get" class="ApiPlatform\Metadata\NotExposed" routePrefix="admin" />
        </operations>
    </resource>

    <resource class="%sylius.model.newsletter_subscription_log_entry.class%" uriTemplate="/admin/customers/{id}/newsletter-subscription-log-entries">
        <uriVariables>
            <uriVariable parameterName="id" fromClass="%sylius.model.customer.class%" toProperty="customer" />
        </uriVariables>

        <operations>
            <operation name="sylius_api_admin_customer_newsletter_subscription_log_entry_get_collection" class="ApiPlatform\Metadata\GetCollection">
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius:admin:customer:newsletter_subscription_log_entry:index</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <order>
                    <values>
                        <value name="loggedAt">DESC</value>
                        <value name="id">DESC</value>
                    </values>
                </order>
            </operation>
        </operations>
    </resource>
</resources>
